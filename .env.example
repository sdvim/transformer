# Rate limiting
SCRAPE_REQUESTS_PER_SECOND=1.0
SCRAPE_MAX_RETRIES=3

# Browser settings
SCRAPE_HEADLESS_BROWSER=true
SCRAPE_BROWSER_TIMEOUT_MS=30000

# Logging
SCRAPE_LOG_LEVEL=INFO

# Last.fm API credentials
# Get your API key at https://www.last.fm/api/account/create
LASTFM_USER=your_username
LASTFM_API_KEY=your_api_key_here
LASTFM_SHARED_SECRET=your_shared_secret_here

# YouTube Data API v3 credentials
# Get your API key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
